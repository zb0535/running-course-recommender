# 이 파일을 .env로 복사한 뒤 값을 채우세요. .env는 서버를 시작할 때 자동으로 읽힙니다.
# 키가 없어도 지도·DB 코스 추천·턴바이턴은 동작합니다.

# 실시간 코스 생성(보행자 경로) — https://console.tmapmobility.com/
TMAP_APP_KEY=

# 실시간 날씨 — https://apihub.kma.go.kr/ (단기예보 API 활용신청 필요)
KMA_API_KEY=

# GraphML 순환 코스 파일럿. 용봉동 검증 후에만 1로 켭니다.
# 켜면 서버 시작 시 지역 GraphML을 워커 메모리에 한 번 로드합니다.
GRAPH_LOOP_ENABLED=0
GRAPH_LOOP_MAP_PATH=data/graph/yongbong.graphml
